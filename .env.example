# Betting-Brain v3 Environment Configuration
# Copy this file to .env and update with your values

# Cloudflare Configuration
CLOUDFLARE_API_TOKEN=your-api-token-here
CLOUDFLARE_ACCOUNT_ID=your-account-id-here

# Database Configuration
D1_DATABASE_ID=your-d1-database-id-here
D1_DATABASE_NAME=betting-analytics

# Queue Configuration
LINE_INGRESS_QUEUE=line-ingress
STEAM_WEBHOOK_QUEUE=steam-webhook

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_SECOND=10
RATE_LIMIT_BURST=20
RATE_LIMIT_WINDOW_SIZE=60

# Cost Cap Configuration
COST_CAP_D1_MAX_SIZE=5368709120
COST_CAP_D1_MAX_ROWS=50000000
COST_CAP_QUEUE_MAX_OPS=1000000
COST_CAP_ANALYTICS_MAX_POINTS=25000000
COST_CAP_MAX_REQUESTS_PER_DAY=100000

# Alert Thresholds
ALERT_CLV_THRESHOLD=-2
ALERT_HOLD_MIN=4
ALERT_HOLD_MAX=8
ALERT_EXPOSURE_MAX_AMOUNT=50000
ALERT_EXPOSURE_MAX_PERCENTAGE=60
ALERT_SHARP_SCORE_THRESHOLD=60
ALERT_STEAM_SIGMA=3
ALERT_STEAM_TIME_WINDOW=60

# Feature Flags
ENABLE_COST_CAP=true
ENABLE_RATE_LIMIT=true
ENABLE_TTL_CLEANUP=true
ENABLE_ANALYTICS=true

# Environment
NODE_ENV=development

# ============================================================================
# Sports API Configuration (Production MCP Integration)
# ============================================================================

# Worker URL for MCP tools
WORKER_URL=https://betting-brain-v3.nolarose1968-806.workers.dev

# Grafana Integration (Optional)
GRAFANA_URL=https://your-grafana-instance.com
GRAFANA_KEY=your-grafana-api-key

# Sports API Keys with Daily Rotation
# Pattern: KEY_1, KEY_2, KEY_3 for daily rotation
# Rotation cycles through 1→2→3 based on day of year

# Pinnacle Sports API
PINNACLE_KEY_1=your-pinnacle-api-key-1
PINNACLE_KEY_2=your-pinnacle-api-key-2
PINNACLE_KEY_3=your-pinnacle-api-key-3

# Bet365 API
BET365_KEY_1=your-bet365-api-key-1
BET365_KEY_2=your-bet365-api-key-2
BET365_KEY_3=your-bet365-api-key-3

# SportsData.io API
SPORTSDATA_KEY_1=your-sportsdata-io-key-1
SPORTSDATA_KEY_2=your-sportsdata-io-key-2
SPORTSDATA_KEY_3=your-sportsdata-io-key-3

# JWT Secret for /ingest endpoint (minimum 32 characters)
JWT_SECRET=your-jwt-secret-minimum-32-characters-long

# ============================================================================
# Autonomous Trading Configuration (v3.4.0)
# ============================================================================

# Trading Control (CRITICAL - Set to false initially!)
TRADING_ENABLED=false  # Set to true to enable autonomous bet placement
TRADING_DRY_RUN=true   # Set to false for real bets (USE WITH CAUTION!)

# WebSocket Stream
FANTASY402_WS_URL=wss://fantasy402.com/live

# Alert Integration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# Dashboard Authentication
TRADING_DASHBOARD_TOKEN=your-secure-dashboard-token-here

# Risk Limits
TRADING_MAX_BET_SIZE=1000           # $1,000 max per bet
TRADING_MAX_DAILY_VOLUME=10000      # $10,000 max daily
TRADING_MAX_TOTAL_EXPOSURE=50000    # $50,000 max exposure
TRADING_MAX_EVENT_EXPOSURE=5000     # $5,000 max per event

# Circuit Breaker Thresholds
CB_MAX_MODEL_UNCERTAINTY=0.15       # 15% max uncertainty
CB_MAX_CONSECUTIVE_FAILURES=3       # 3 API failures triggers CB
CB_MAX_DAILY_LOSS=10000            # $10k daily loss limit
CB_MIN_BALANCE_DELTA=-0.10         # -10% balance delta triggers CB

# Model Training
MODEL_AUTO_TRAIN=true
MODEL_TRAINING_INTERVAL_HOURS=24
MODEL_LOOKBACK_DAYS=7

# ============================================================================
# Production Deployment Notes
# ============================================================================
# - Never commit .env with real values
# - Use wrangler secrets for production:
#   wrangler secret put JWT_SECRET
#   wrangler secret put PINNACLE_KEY_1
#   wrangler secret put TRADING_ENABLED
# - Key rotation happens automatically based on day of year
# - If you only have 1 key, use PINNACLE_KEY without suffix
#
# AUTONOMOUS TRADING SAFETY:
# - Start with TRADING_ENABLED=false
# - Test in dry-run mode (TRADING_DRY_RUN=true) for at least 1 week
# - Monitor circuit breaker alerts
# - Set conservative risk limits initially
# - Gradually increase limits after proving stability

## Request ID Tracking

### Generate and Use

```typescript
import { generateRequestId, getRequestId } from '../utils/request';
import { createLogger } from '../utils/logger';

// Generate at start of request
const requestId = generateRequestId();

// Or extract from headers
const requestId = getRequestId(request);

// Use structured logging
const logger = createLogger(request);
logger.info('request_received', { requestId });
logger.info('request_completed', { requestId });
logger.error('request_failed', { requestId }, error);

// Include in response (automatic with createJSONResponse)
return createJSONResponse({
  ...data,
  requestId
});

// Include in errors
return createErrorResponse('Error message', 500, 'ERROR_CODE', requestId);
```


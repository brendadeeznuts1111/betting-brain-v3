## Error Handling Patterns

### Using Error Classes

**Location:** `src/utils/error-handler.ts`

```typescript
import { Errors, createErrorResponse } from '../utils/error-handler';

// In endpoint handler
try {
  // Validation error
  if (!isValid) {
    throw Errors.validationError(['Field is required']);
  }
  
  // Not found
  if (!record) {
    throw Errors.notFound('Event');
  }
  
  // Database error
  if (queryFailed) {
    throw Errors.databaseError('Query failed: ' + error.message);
  }
  
  // Success response
  return new Response(JSON.stringify(data), {
    headers: { 'Content-Type': 'application/json' }
  });
  
} catch (error) {
  return createErrorResponse(error, requestId, url.pathname);
}
```

### Error Types

```typescript
// Client errors (4xx)
Errors.badRequest(message, details?)       // 400
Errors.unauthorized(message?)              // 401
Errors.forbidden(message?)                 // 403
Errors.notFound(resource?)                 // 404
Errors.validationError(errors[])           // 400
Errors.rateLimit(message?)                 // 429

// Server errors (5xx)
Errors.databaseError(message)              // 500
Errors.serviceUnavailable(message?)        // 503
Errors.timeout(message?)                   // 504
```

### Async Handler Wrapper

```typescript
import { asyncHandler } from '../utils/error-handler';

// Automatically catches and formats errors
export const myEndpoint = asyncHandler(async (request, env, ctx) => {
  // Your code here
  // Any thrown errors will be caught and formatted automatically
  return new Response(JSON.stringify(result));
});
```


## API Endpoint Patterns

### REST API Structure

**Location:** `src/api/routes.ts`

```typescript
import { generateRequestId, CORS_HEADERS, createOPTIONSResponse } from '../utils/request';

export async function handleAPIRoute(
  request: Request,
  env: Env,
  ctx: ExecutionContext
): Promise<Response> {
  const requestId = generateRequestId();
  const url = new URL(request.url);
  const path = url.pathname.replace('/api', '');

  // Handle OPTIONS preflight
  if (request.method === 'OPTIONS') {
    return createOPTIONSResponse();
  }

  try {
    // Route to endpoint
    switch (path) {
      case '/events':
        return await getEvents(request, env, requestId);
      // ... more routes
      default:
        throw Errors.notFound('API endpoint');
    }
  } catch (error) {
    return createErrorResponse(error, requestId, path);
  }
}
```

### Endpoint Handler Pattern

```typescript
import {
  normalizeD1Result,
  createJSONResponse,
  getQueryParamNumber
} from '../utils/request';
import { createLogger } from '../utils/logger';

async function getMyEndpoint(
  request: Request,
  env: Env,
  requestId: string
): Promise<Response> {
  const logger = createLogger(request);

  // 1. Validate environment
  validateEnv(env, ['ANALYTICS']);

  // 2. Validate input
  const validation = validateQueryParams(url, [
    Validators.agentID(),
    Validators.limit(500)
  ]);

  if (!validation.valid) {
    return validationErrorResponse(validation.errors, requestId);
  }

  const { agentID, limit } = validation.sanitized!;

  // 3. Query database
  const result = await env.ANALYTICS.prepare(`
    SELECT * FROM table WHERE aid = ? LIMIT ?
  `).bind(agentID, limit).all();

  const data = normalizeD1Result<MyType>(result);

  // 4. Log success
  logger.info('query_completed', {
    requestId,
    recordCount: data.length
  });

  // 5. Return response
  return createJSONResponse({
    data,
    total: data.length,
    requestId,
    timestamp: new Date().toISOString()
  });
}
```


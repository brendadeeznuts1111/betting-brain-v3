## API Endpoint Patterns

### REST API Structure

**Location:** `src/api/routes.ts`

```typescript
export async function handleAPIRoute(
  request: Request,
  env: Env,
  ctx: ExecutionContext
): Promise<Response> {
  const requestId = Date.now().toString(36);
  const url = new URL(request.url);
  const path = url.pathname.replace('/api', '');

  // CORS headers
  const corsHeaders = {
    'Access-Control-Allow-Origin': '*',
    'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
    'Access-Control-Allow-Headers': 'Content-Type',
    'Content-Type': 'application/json'
  };

  // Handle OPTIONS preflight
  if (request.method === 'OPTIONS') {
    return new Response(null, { headers: corsHeaders });
  }

  try {
    // Route to endpoint
    switch (path) {
      case '/events':
        return await getEvents(request, env, requestId);
      // ... more routes
      default:
        throw Errors.notFound('API endpoint');
    }
  } catch (error) {
    return createErrorResponse(error, requestId, path);
  }
}
```

### Endpoint Handler Pattern

```typescript
async function getMyEndpoint(
  request: Request,
  env: Env,
  requestId: string
): Promise<Response> {
  // 1. Validate environment
  validateEnv(env, ['ANALYTICS']);

  // 2. Validate input
  const url = new URL(request.url);
  const validation = validateQueryParams(url, [
    Validators.agentID(),
    Validators.limit(500)
  ]);

  if (!validation.valid) {
    return validationErrorResponse(validation.errors, requestId);
  }

  const { agentID, limit } = validation.sanitized!;

  // 3. Query database
  const result = await env.ANALYTICS.prepare(`
    SELECT * FROM table WHERE aid = ? LIMIT ?
  `).bind(agentID, limit).all();

  const data = result.results as unknown as MyType[];

  // 4. Log success
  console.log(`[${requestId}] ✅ Found ${data.length} records`);

  // 5. Return response
  return new Response(JSON.stringify({
    data,
    total: data.length,
    requestId,
    timestamp: new Date().toISOString()
  }), {
    headers: {
      'Content-Type': 'application/json',
      'Access-Control-Allow-Origin': '*'
    }
  });
}
```


## 5. Error Handling - No Silent Failures

### ❌ WRONG

```typescript
// Empty catch block
try {
  await operation();
} catch (error) {
  // Silent failure
}

// Generic error
try {
  await operation();
} catch (error) {
  console.error('Error:', error);
  return null;
}
```

### ✅ CORRECT

```typescript
import { createErrorResponse, APIError, ErrorCode } from '../utils/error-handler';
import { createLogger } from '../utils/logger';

const logger = createLogger(request);

try {
  await riskyOperation();
} catch (error) {
  logger.error('operation_failed', {
    operation: 'processData',
    requestId
  }, error as Error);

  return createErrorResponse(
    error as Error,
    requestId,
    request.url
  );
}

// Specific error types
if (!params.eid) {
  throw new APIError(
    ErrorCode.VALIDATION_ERROR,
    'Event ID is required',
    400,
    { field: 'eid' }
  );
}

// Retryable classification
function isRetryableError(error: unknown): boolean {
  if (error instanceof Error) {
    // Don't retry validation errors
    if (error.name === 'ZodError') return false;
    // Retry network errors
    if (error.message.includes('timeout')) return true;
  }
  return true;
}
```

### Rule: Explicit Error Handling

1. **Never swallow errors** - Always log or propagate
2. **Use typed errors** - Use `APIError` for known errors
3. **Provide context** - Include operation name, parameters
4. **Classify errors** - Retryable vs non-retryable
5. **User-friendly messages** - Don't expose internal details


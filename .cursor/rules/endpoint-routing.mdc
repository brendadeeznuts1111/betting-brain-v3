## Adding New Endpoints

### 1. Core/System Endpoint

**Add to main fetch handler:**
```typescript
import { generateRequestId } from '../utils/request';
import { createLogger } from '../utils/logger';

const requestId = generateRequestId();
const logger = createLogger(request);

if (url.pathname === '/my-endpoint') {
  logger.info('endpoint_accessed', { endpoint: '/my-endpoint', requestId });
  return handleMyEndpoint(request, env, ctx);
}
```

**Create handler function:**
```typescript
import {
  generateRequestId,
  createJSONResponse,
  createErrorResponse
} from '../utils/request';
import { createLogger } from '../utils/logger';

async function handleMyEndpoint(
  request: Request,
  env: Env,
  ctx: ExecutionContext
): Promise<Response> {
  const requestId = generateRequestId();
  const logger = createLogger(request);

  try {
    logger.info('handler_started', { requestId });
    // Your logic here
    return createJSONResponse({ data, requestId });
  } catch (error) {
    logger.error('handler_failed', { requestId }, error as Error);
    return createErrorResponse(
      error instanceof Error ? error.message : 'Unknown error',
      500,
      'HANDLER_ERROR',
      requestId
    );
  }
}
```


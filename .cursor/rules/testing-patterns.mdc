## Common Patterns

### Testing Async Functions

```typescript
test('should handle async operations', async () => {
  const result = await myAsyncFunction();
  expect(result).toBe(expected);
});
```

### Testing Error Handling

```typescript
test('should throw on invalid input', () => {
  expect(() => {
    myFunction(invalidInput);
  }).toThrow('Expected error message');
});

test('should reject promise', async () => {
  await expect(myAsyncFunction()).rejects.toThrow('Error');
});
```

### Testing with Mocks

```typescript
import { mock } from 'bun:test';

test('should call function', () => {
  const mockFn = mock(() => 'result');
  const result = mockFn();
  
  expect(mockFn).toHaveBeenCalled();
  expect(mockFn).toHaveBeenCalledTimes(1);
  expect(result).toBe('result');
});
```

## Performance Testing

```typescript
test('should complete within time limit', async () => {
  const start = Date.now();
  
  await myFunction();
  
  const duration = Date.now() - start;
  expect(duration).toBeLessThan(1000); // < 1 second
});
```

## Skipping Tests

```typescript
// Skip a single test
test.skip('not ready yet', () => {
  // Will not run
});

// Skip entire suite
describe.skip('WIP feature', () => {
  test('test 1', () => {});
  test('test 2', () => {});
});
```

## Test Execution

### Local Development

```bash
# Run all tests
bun test

# Watch mode
bun test --watch

# Specific file
bun test tests/unit/clv.test.ts

# With coverage
bun test --coverage

# Concurrent
bun test --concurrent
```

### CI Environment

```bash
# Full test suite with timeout
bun test --timeout 10000

# Quick tests
bun test tests/unit --timeout 5000

# Integration tests
bun test tests/integration --timeout 20000
```


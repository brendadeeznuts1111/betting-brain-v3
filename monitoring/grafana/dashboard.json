    "templating": {
      "list": [
        {
          "name": "DS_ANALYTICS_ENGINE",
          "type": "datasource",
          "query": "cloudflare-analytics-engine",
          "current": {
            "text": "Cloudflare Analytics Engine",
            "value": "cloudflare-analytics-engine"
          }
        },
        {
          "name": "DS_PROMETHEUS",
          "type": "datasource",
          "query": "prometheus",
          "current": {
            "text": "Prometheus",
            "value": "prometheus"
          }
        }
      ]
    },
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": [
        "10s",
        "30s",
        "1m",
        "5m",
        "15m"
      ],
      "time_options": [
        "5m",
        "15m",
        "1h",
        "6h",
        "12h",
        "24h",
        "7d"
      ]
    },
    "annotations": {
      "list": [
        {

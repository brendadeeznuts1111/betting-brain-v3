      {
        "id": 13,
        "title": "⚡ Worker Request Rate (req/s)",
        "type": "graph",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "targets": [
          {
            "expr": "rate(cloudflare_worker_requests_total[1m])",
            "refId": "A",
            "legendFormat": "Requests/sec"
          }
        ],
        "yaxes": [
          {
            "format": "reqps",
            "label": "req/s"
          }
        ],
        "gridPos": {
          "h": 6,
          "w": 8,
          "x": 0,
          "y": 26
        }
      },
      {
        "id": 14,
        "title": "🕐 Worker Response Time (p50, p95, p99)",
        "type": "graph",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, cloudflare_worker_duration_seconds_bucket)",
            "refId": "A",
            "legendFormat": "p50"
          },
          {
            "expr": "histogram_quantile(0.95, cloudflare_worker_duration_seconds_bucket)",
            "refId": "B",
            "legendFormat": "p95"
          },
          {
            "expr": "histogram_quantile(0.99, cloudflare_worker_duration_seconds_bucket)",
            "refId": "C",
            "legendFormat": "p99"
          }
        ],
        "yaxes": [
          {
            "format": "ms",
            "label": "Latency"
          }
        ],
        "gridPos": {
          "h": 6,
          "w": 8,
          "x": 8,
          "y": 26
        }
      },
      {
        "id": 15,
        "title": "❌ Error Rate %",
        "type": "graph",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "targets": [
          {
            "expr": "rate(cloudflare_worker_errors_total[1m]) / rate(cloudflare_worker_requests_total[1m]) * 100",
            "refId": "A",
            "legendFormat": "Error %"
          }
        ],
        "yaxes": [
          {
            "format": "percent",
            "label": "Error %",
            "max": 5
          }
        ],
        "alert": {
          "conditions": [
            {
              "evaluator": {
                "params": [
                  1
                ],
                "type": "gt"
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": [
                  "A",
                  "5m",
                  "now"
                ]
              },
              "reducer": {
                "params": [],
                "type": "avg"
              },
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "frequency": "1m",
          "handler": 1,
          "name": "High Error Rate Alert",
          "noDataState": "no_data",
          "notifications": []
        },
        "gridPos": {
          "h": 6,
          "w": 8,
          "x": 16,
          "y": 26
        }
      },
      {

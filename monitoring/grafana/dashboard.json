{
  "dashboard": {
    "title": "Betting-Brain v3 - Real-Time Intelligence & Cost Monitoring",
    "description": "Production dashboard for edge-native betting intelligence with cost cap visualization",
    "tags": [
      "betting",
      "intelligence",
      "edge",
      "cloudflare",
      "cost-monitoring"
    ],
    "timezone": "browser",
    "refresh": "30s",
    "schemaVersion": 38,
    "version": 1,
    "panels": [
      {
        "id": 1,
        "title": "🚨 CLV Alerts (< -5% or > +5%)",
        "type": "stat",
        "datasource": {
          "type": "cloudflare-analytics-engine",
          "uid": "${DS_ANALYTICS_ENGINE}"
        },
        "targets": [
          {
            "dataset": "betting_brain_analytics",
            "query": "SELECT count() as alert_count FROM betting_brain_analytics WHERE index1 = 'clv_alert' AND timestamp > now() - INTERVAL '1' HOUR",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "green"
                },
                {
                  "value": 1,
                  "color": "yellow"
                },
                {
                  "value": 5,
                  "color": "red"
                }
              ]
            },
            "unit": "short",
            "mappings": []
          }
        },
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": [
              "lastNotNull"
            ],
            "fields": ""
          },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "background"
        },
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 0,
          "y": 0
        }
      },
      {
        "id": 2,
        "title": "📊 Hold % Alerts (<3% or >15%)",
        "type": "stat",
        "datasource": {
          "type": "cloudflare-analytics-engine",
          "uid": "${DS_ANALYTICS_ENGINE}"
        },
        "targets": [
          {
            "dataset": "betting_brain_analytics",
            "query": "SELECT count() as alert_count FROM betting_brain_analytics WHERE index1 = 'hold_alert' AND timestamp > now() - INTERVAL '1' HOUR",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "green"
                },
                {
                  "value": 1,
                  "color": "yellow"
                },
                {
                  "value": 5,
                  "color": "red"
                }
              ]
            }
          }
        },
        "options": {
          "colorMode": "background",
          "textMode": "auto"
        },
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 6,
          "y": 0
        }
      },
      {
        "id": 3,
        "title": "💰 Exposure Alerts ($50k / 60%)",
        "type": "stat",
        "datasource": {
          "type": "cloudflare-analytics-engine",
          "uid": "${DS_ANALYTICS_ENGINE}"
        },
        "targets": [
          {
            "dataset": "betting_brain_analytics",
            "query": "SELECT count() as alert_count FROM betting_brain_analytics WHERE index1 = 'exposure_alert' AND timestamp > now() - INTERVAL '1' HOUR",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "green"
                },
                {
                  "value": 1,
                  "color": "orange"
                },
                {
                  "value": 3,
                  "color": "red"
                }
              ]
            }
          }
        },
        "options": {
          "colorMode": "background"
        },
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 12,
          "y": 0
        }
      },
      {
        "id": 4,
        "title": "🎯 Sharp Score Alerts (>60)",
        "type": "stat",
        "datasource": {
          "type": "cloudflare-analytics-engine",
          "uid": "${DS_ANALYTICS_ENGINE}"
        },
        "targets": [
          {
            "dataset": "betting_brain_analytics",
            "query": "SELECT count() as alert_count FROM betting_brain_analytics WHERE index1 = 'sharp_alert' AND double1 > 60 AND timestamp > now() - INTERVAL '1' HOUR",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "green"
                },
                {
                  "value": 1,
                  "color": "yellow"
                },
                {
                  "value": 10,
                  "color": "red"
                }
              ]
            }
          }
        },
        "options": {
          "colorMode": "background"
        },
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 18,
          "y": 0
        }
      },
      {
        "id": 5,
        "title": "💵 Total Exposure by Event (Last Hour)",
        "type": "graph",
        "datasource": {
          "type": "cloudflare-analytics-engine",
          "uid": "${DS_ANALYTICS_ENGINE}"
        },
        "targets": [
          {
            "dataset": "betting_brain_analytics",
            "query": "SELECT blob1 as event_id, sum(double1) as total_risk FROM betting_brain_analytics WHERE index1 = 'exposure_alert' AND timestamp > now() - INTERVAL '1' HOUR GROUP BY blob1 ORDER BY total_risk DESC LIMIT 10",                                  
            "refId": "A",
            "legendFormat": "{{event_id}}"
          }
        ],
        "yaxes": [
          {
            "format": "currencyUSD",
            "label": "Total Risk"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 4
        }
      },
      {
        "id": 6,
        "title": "🔥 Steam Moves (Last Hour)",
        "type": "table",
        "datasource": {
          "type": "cloudflare-analytics-engine",
          "uid": "${DS_ANALYTICS_ENGINE}"
        },
        "targets": [
          {
            "dataset": "betting_brain_analytics",
            "query": "SELECT timestamp, blob1 as event_id, blob2 as market_type, double1 as line_change, double2 as volume_change, double3 as sigma FROM betting_brain_analytics WHERE index1 = 'steam_move' AND timestamp > now() - INTERVAL '1' HOUR ORDER BY timestamp DESC LIMIT 50",                                                                                                                
            "refId": "A"
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {},
              "indexByName": {
                "timestamp": 0,
                "event_id": 1,
                "market_type": 2,
                "line_change": 3,
                "volume_change": 4,
                "sigma": 5
              },
              "renameByName": {
                "timestamp": "Time",
                "event_id": "Event ID",
                "market_type": "Market",
                "line_change": "Line Change",
                "volume_change": "Volume Change",
                "sigma": "Sigma (σ)"
              }
            }
          }
        ],
        "options": {
          "showHeader": true,
          "sortBy": [
            {
              "displayName": "Time",
              "desc": true
            }
          ]
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 4
        }
      },
      {
        "id": 7,
        "title": "🎓 Top 10 Sharp Customers",
        "type": "table",
        "datasource": {
          "type": "cloudflare-analytics-engine",
          "uid": "${DS_ANALYTICS_ENGINE}"
        },
        "targets": [
          {
            "dataset": "betting_brain_analytics",
            "query": "SELECT blob1 as customer_id, max(double1) as sharp_score, max(double2) as clv, max(double3) as win_rate FROM betting_brain_analytics WHERE index1 = 'sharp_score' AND timestamp > now() - INTERVAL '24' HOUR GROUP BY blob1 ORDER BY sharp_score DESC LIMIT 10",
            "refId": "A"
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "renameByName": {
                "customer_id": "Customer ID",
                "sharp_score": "Sharp Score",
                "clv": "CLV",
                "win_rate": "Win Rate %"
              }
            }
          }
        ],
        "fieldConfig": {
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "Sharp Score"
              },
              "properties": [
                {
                  "id": "custom.cellOptions",
                  "value": {
                    "type": "color-background"
                  }
                },
                {
                  "id": "thresholds",
                  "value": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "green"
                      },
                      {
                        "value": 50,
                        "color": "yellow"
                      },
                      {
                        "value": 70,
                        "color": "red"
                      }
                    ]
                  }
                }
              ]
            }
          ]
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 12
        }
      },
      {
        "id": 8,
        "title": "📈 Hold Percentage by Market Type",
        "type": "graph",
        "datasource": {
          "type": "cloudflare-analytics-engine",
          "uid": "${DS_ANALYTICS_ENGINE}"
        },
        "targets": [
          {
            "dataset": "betting_brain_analytics",
            "query": "SELECT timestamp, blob1 as market_type, avg(double1) as hold_pct FROM betting_brain_analytics WHERE index1 = 'hold_percentage' AND timestamp > now() - INTERVAL '6' HOUR GROUP BY timestamp, blob1 ORDER BY timestamp",
            "refId": "A",
            "legendFormat": "{{market_type}}"
          }
        ],
        "yaxes": [
          {
            "format": "percent",
            "label": "Hold %",
            "min": 0,
            "max": 20
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 12
        }
      },
      {
        "id": 9,
        "title": "💰 Cost Cap Remaining - D1 Reads",
        "type": "gauge",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "targets": [
          {
            "expr": "(1 - (cloudflare_d1_reads_today / 100000)) * 100",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "percentage",
              "steps": [
                {
                  "value": 0,
                  "color": "red"
                },
                {
                  "value": 20,
                  "color": "orange"
                },
                {
                  "value": 50,
                  "color": "green"
                }
              ]
            },
            "unit": "percent",
            "min": 0,
            "max": 100
          }
        },
        "options": {
          "showThresholdLabels": true,
          "showThresholdMarkers": true
        },
        "gridPos": {
          "h": 6,
          "w": 6,
          "x": 0,
          "y": 20
        }
      },
      {
        "id": 10,
        "title": "💰 Cost Cap Remaining - D1 Writes",

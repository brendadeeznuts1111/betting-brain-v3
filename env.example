# Environment Configuration Example
# Copy this file to .env and update values for your environment

# Environment (development, staging, production)
NODE_ENV=development

# Worker URLs
WORKER_URL_DEV=http://localhost:8787
WORKER_URL_STAGING=https://betting-brain-v3-staging.nolarose1968-806.workers.dev
WORKER_URL_PROD=https://betting-brain-v3.nolarose1968-806.workers.dev

# API Configuration
API_BASE_URL=http://localhost:8787/api
WEBSOCKET_URL=ws://localhost:8787/ws

# Logging
LOG_LEVEL=info
LOG_ENDPOINT=http://localhost:8787/logs

# Health Check
HEALTH_ENDPOINT=http://localhost:8787/health

# Interceptor
INTERCEPTOR_ENDPOINT=http://localhost:8787/interceptor

# Database
DATABASE_URL=sqlite:./data/analytics.db

# Cache
CACHE_TTL=300
CACHE_SIZE=1000

# Rate Limiting
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60

# Security
JWT_SECRET=your-jwt-secret-here
CORS_ORIGIN=*

# Monitoring
ENABLE_METRICS=true
METRICS_ENDPOINT=http://localhost:8787/metrics

# 🧠 Betting-Brain v3 - Environment Configuration Template
# Copy this file to .env.local, .env.staging, or .env.production and fill in your values

# Environment
NODE_ENV=development
DEBUG=true
LOG_LEVEL=debug

# Cloudflare Configuration
CLOUDFLARE_ACCOUNT_ID=your-account-id-here
CLOUDFLARE_API_TOKEN=your-api-token-here

# Database Configuration
DATABASE_URL=file:./local.db
DATABASE_MIGRATIONS_DIR=migrations

# Analytics Configuration
ANALYTICS_ENABLED=true
ANALYTICS_SAMPLE_RATE=1.0
ANALYTICS_DATASET=betting-metrics

# Queue Configuration
QUEUE_LINE_INGRESS=line-ingress
QUEUE_STEAM_WEBHOOK=steam-webhook
QUEUE_MAX_BATCH_SIZE=10
QUEUE_MAX_BATCH_TIMEOUT=5

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_SECOND=10
RATE_LIMIT_BURST_LIMIT=20
RATE_LIMIT_WINDOW_SIZE=60

# Cost Cap Configuration
COST_CAP_D1_MAX_SIZE=5368709120
COST_CAP_D1_MAX_ROWS=50000000
COST_CAP_QUEUE_MAX_OPS_PER_MONTH=1000000
COST_CAP_ANALYTICS_MAX_POINTS_PER_MONTH=25000000
COST_CAP_REQUESTS_MAX_PER_DAY=100000

# Security Configuration
ENCRYPTION_KEY=your-encryption-key-here
CORS_ORIGINS=http://localhost:3000,https://your-domain.com

# Monitoring Configuration
SENTRY_DSN=your-sentry-dsn-here
GRAFANA_URL=https://your-grafana.pages.dev
MONITORING_ENABLED=true

# Performance Configuration
CACHE_ENABLED=true
CACHE_TTL=300
MEMORY_LIMIT=128
CPU_LIMIT=50

# Alert Configuration
ALERT_WEBHOOK_URL=your-webhook-url-here
ALERT_EMAIL=your-email@example.com
ALERT_SLACK_WEBHOOK=your-slack-webhook-here

# Development Configuration
HOT_RELOAD=true
SOURCE_MAPS=true
MOCK_DATA=false

# Testing Configuration
TEST_DATABASE_URL=file:./test.db
TEST_ANALYTICS_ENABLED=false
TEST_MOCK_EXTERNAL_SERVICES=true

# BetTicker Interceptor Configuration
BET_TICKER_ENABLED=true
BET_TICKER_RAW_TTL_DAYS=7
BET_TICKER_ORIGIN=https://fantasy402.com
BET_TICKER_PATH=/cloud/api/Manager/getBetTicker
BET_TICKER_KV_NAMESPACE_ID=your-kv-namespace-id
BET_TICKER_KV_PREVIEW_ID=your-preview-kv-id

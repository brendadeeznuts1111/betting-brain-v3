{
  "name": "betting-brain-v3",
  "version": "3.3.0",
  "description": "Enterprise-grade betting data interceptor with circuit breaker and health monitoring",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "build:worker": "bun build src/index.ts --outdir dist --target bun --minify",
    "start": "bun run src/index.ts",
    "search": "bun scripts/search.ts",
    "search:index": "bun scripts/rg-indexer.ts --rebuild",
    "fmt": "prettier --write \"**/*.{ts,json,md}\" && bun scripts/organize-imports.ts && bun scripts/rg-indexer.ts --rebuild",
    "fmt:check": "prettier --check \"**/*.{ts,json,md}\" && bun scripts/rg-indexer.ts --check",
    "docs": "bun scripts/docs-generator.ts",
    "docs:check": "bun scripts/docs-generator.ts && git diff --exit-code docs/api",
    "dataflow": "bun scripts/dataflow.ts",
    "test": "bun run scripts/test-runner.ts",
    "test:quiet": "QUIET=1 bun run scripts/test-runner.ts --quiet",
    "test:ai": "CLAUDECODE=1 bun run scripts/test-runner.ts --quiet",
    "test:unit": "bun run scripts/test-runner.ts --category unit",
    "test:integration": "bun run scripts/test-runner.ts --category integration",
    "test:e2e": "bun run scripts/test-runner.ts --category e2e",
    "test:performance": "bun run scripts/test-runner.ts --category performance",
    "test:snapshot": "bun run scripts/test-runner.ts --category snapshot",
    "test:fast": "bun run scripts/test-runner.ts --category unit --timeout 5000",
    "test:all": "bun run scripts/test-runner.ts --no-skip",
    "test:watch": "bun run scripts/test-runner.ts --watch",
    "test:coverage": "bun run scripts/test-runner.ts --coverage",
    "test:ci": "CI=true bun run scripts/test-runner.ts --quiet",
    "test:verbose": "bun run scripts/test-runner.ts --verbose",
    "test:serial": "bun run scripts/test-runner.ts --serial",
    "test:organize": "bun run scripts/organize-tests.ts",
    "test:organize:report": "bun run scripts/organize-tests.ts --report",
    "test:cache:clear": "rm -f .test-cache.json",
    "test:cache:info": "bun run scripts/test-runner.ts --cache-info",
    "test:scopes": "bun run scripts/test-scope-manager.ts list-scopes",
    "test:environments": "bun run scripts/test-scope-manager.ts list-environments",
    "test:scope": "bun run scripts/test-scope-manager.ts get-command",
    "test:integration:pre-commit": "bun run scripts/test-integration.ts pre-commit",
    "test:integration:ci": "bun run scripts/test-integration.ts ci",
    "test:integration:ai": "bun run scripts/test-integration.ts ai",
    "test:integration:dev": "bun run scripts/test-integration.ts dev",
    "test:integration:status": "bun run scripts/test-integration.ts status",
    "ci": "bun run ci:full",
    "ci:full": "bun run security && bun run lint && bun run type-check && bun run test:integration:ci && bun run build:worker && echo '✅ All CI checks passed!'",
    "ci:quick": "bun run security && bun run test:fast && echo '✅ Quick CI passed!'",
    "ci:local": "bun run scripts/ci-local.ts",
    "ci:bun": "bun run scripts/bun-ci.ts",
    "ci:bun:quick": "bun run scripts/bun-ci.ts --skip-tests --skip-security",
    "ci:bun:full": "bun run scripts/bun-ci.ts --verbose",
    "lint": "bun run scripts/lint.ts",
    "format": "bun run scripts/format.ts",
    "format:check": "bun run scripts/format-check.ts",
    "type-check": "tsc --noEmit",
    "deploy": "bun run scripts/deploy.ts",
    "deploy:staging": "bun run scripts/deploy.ts --env staging",
    "deploy:production": "bun run scripts/deploy.ts --env production",
    "test:extension": "bun run scripts/testing/extension-test-runner.ts",
    "test:automation": "bun run scripts/automation/build-and-test.ts",
    "monitor:logs": "bun run tools/logging/log-monitor.js",
    "monitor:web": "open tools/logging/log-viewer.html",
    "monitor:dashboard": "bun run scripts/start-monitoring.sh",
    "monitor:worker": "wrangler tail --format pretty",
    "monitor:queues": "wrangler queues list",
    "dashboard:deploy": "bun run scripts/deploy-dashboards.ts",
    "dashboard:grafana": "bun run scripts/push-grafana.ts",
    "dashboard:bump": "bun run scripts/update-readme.ts",
    "dashboard:all": "bun run dashboard:deploy && bun run dashboard:grafana && bun run dashboard:bump",
    "test:injection": "open tools/testing/extension-injection-tester.html",
    "docs:generate": "bun run scripts/docs-generator.ts",
    "health:check": "curl -s https://betting-brain-v3.nolarose1968-806.workers.dev/health | jq",
    "health:ping": "bun run scripts/health-ping.ts",
    "guard:analytics": "bun run scripts/guard-analytics-stub.ts",
    "release": "bun run scripts/release.ts",
    "release:dry": "bun run scripts/release.ts --dry-run",
    "freshness": "bun update && bun test --randomize",
    "forest": "bun run scripts/forest.ts",
    "forest:health": "bun run scripts/forest.ts health",
    "forest:fresh": "bun run scripts/forest.ts fresh",
    "forest:release": "bun run scripts/forest.ts release",
    "forest:analytics": "bun run scripts/forest.ts analytics",
    "forest:mcp": "bun run scripts/forest.ts mcp",
    "floor:health": "bun run scripts/floor-health.ts",
    "floor:mcp": "bun run scripts/mcp-server.ts",
    "floor:voice": "echo '🗣️  Available commands: forest-status, deploy-dashboards, release, live-odds, live-scores, push-sports-data'",
    "floor:deploy": "bun run scripts/floor-health.ts --deploy",
    "floor:status": "curl -s https://betting-brain-v3.nolarose1968-806.workers.dev/floor/status | jq",
    "floor:fix": "bun run scripts/floor-health.ts --fix",
    "floor:test": "bash scripts/floor-smoke-test.sh",
    "floor:test:quick": "bash scripts/floor-smoke-test.sh --quick",
    "extension:load": "echo 'Load extension from browser-extension/ directory in Chrome'",
    "extension:test": "bun run test:extension && bun run test:injection",
    "setup:dev": "bun install && bun run format && bun run lint && bun run test",
    "setup:prod": "bun install --production && bun run build:worker && bun run deploy:production",
    "clean": "rm -rf dist node_modules/.cache coverage",
    "reset": "bun run clean && bun install && bun run setup:dev",
    "security": "sg scan src/",
    "security:migrations": "bun run scripts/validate-migrations.ts",
    "pre-push": "bun run security && bun run security:migrations && echo '✅ Security checks passed'",
    "precheck": "bunx eslint@latest src --max-warnings 0 && bunx ast-grep@latest scan --config sgconfig.yml && echo '✅ Precheck passed!'",
    "precheck:quick": "bunx eslint@latest src --max-warnings 0 && echo '✅ Quick precheck passed!'",
    "precheck:security": "bunx ast-grep@latest scan --filter 'sql-injection-risk' --error && bunx ast-grep@latest scan --filter 'no-parsefloat-stake' --error && echo '✅ Security precheck passed!'",
    "maintenance:health": "bun run scripts/health-check.ts",
    "maintenance:cleanup": "bun run scripts/cleanup-repo.ts",
    "maintenance:version": "bun run scripts/bump-version.ts",
    "maintenance:all": "bun run maintenance:health && bun run maintenance:cleanup && echo '✅ Maintenance complete!'",
    "analytics:test": "bun test tests/unit/analytics-testing-example.test.ts --randomize",
    "analytics:test:coverage": "bun test --coverage --randomize tests/unit/analytics-testing-example.test.ts --config bunfig.analytics.toml",
    "analytics:ci": "CI=true bun run analytics:test:coverage",
    "analytics:nightly": "bun run scripts/nightly-analytics-test.ts",
    "analytics:binding": "bun run scripts/test-analytics-binding.ts",
    "prepare": "husky"
  },
  "keywords": [
    "betting",
    "interceptor",
    "circuit-breaker",
    "health-monitoring",
    "cloudflare-worker",
    "browser-extension",
    "real-time",
    "enterprise"
  ],
  "author": "nolarose1968",
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/openai-compatible": "^1.0.19",
    "@cloudflare/workers-types": "^4.20251008.0",
    "ai": "^5.0.61",
    "async-mutex": "^0.5.0",
    "fuse.js": "^7.0.0",
    "glob": "^10.4.5",
    "jsonwebtoken": "^9.0.2",
    "simple-statistics": "^7.8.8",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.19.1",
    "@types/bun": "^1.0.0",
    "@types/ws": "^8.18.1",
    "chart.js": "^4.5.0",
    "husky": "^9.1.7",
    "typescript": "^5.3.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nolarose1968/betting-brain-v3"
  },
  "bugs": {
    "url": "https://github.com/nolarose1968/betting-brain-v3/issues"
  },
  "homepage": "https://github.com/nolarose1968/betting-brain-v3#readme"
}